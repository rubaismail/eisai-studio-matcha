{
  "name": "@eisai/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/unit.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "db:seed": "tsx src/seed.ts",
    "mail:test": "tsx src/mail-test.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongodb": "6.21.0",
    "nodemailer": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
