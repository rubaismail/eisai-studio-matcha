# Copy this file to .env (npm run setup does it for you), then fill in MONGODB_URI.
# Never commit .env — it holds passwords.

# Empty/false for direct access. For Nginx on this same server, use loopback.
# Only trust the actual proxy addresses; see docs/api/deployment.md.
TRUST_PROXY=

PORT=4000
WEB_ORIGIN=http://localhost:5173

# Ask the Database person for the Team 22 Atlas dev connection string.
# Use the eisai_dev database, never the client's production database.
MONGODB_URI=

# JWT signing secret for authentication.
# Generate using crypto.randomBytes(32).
# Set a different secret for each environment.
JWT_SECRET=

# Public S3 bucket for uploaded menu photos. No real keys should be committed.
AWS_S3_BUCKET=eisai-menu-images
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_PUBLIC_URL=https://eisai-menu-images.s3.amazonaws.com
