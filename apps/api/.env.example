# Local development only. Keep real .env files out of Git.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=eisai_dev_local
# Required deliberate opt-in for sample-data seeding.
ALLOW_DEV_SEED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Eisai Dev <dev@example.test>
