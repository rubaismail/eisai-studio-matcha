# Copy to /etc/eisai/api.env, owned by root with mode 0600. Never commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
TRUST_PROXY=loopback
WEB_ORIGIN=https://stage.example.com
APP_URL=https://stage.example.com
# AWS-hosted MongoDB with authentication; percent-encode credentials.
MONGODB_URI=
JWT_SECRET=
MAILTRAP_TOKEN=
EMAIL_FROM=
MAILTRAP_USE_SANDBOX=false
AWS_REGION=us-east-2
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
# Lightsail: dedicated least-privilege upload credentials, stored only here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For temporary credentials, also set AWS_SESSION_TOKEN and arrange renewal.
