# Install inside Nginx's http context. Replace stage.example.com and certificate paths.
# Omit query strings and Referer so emailed action tokens do not enter access logs.
log_format eisai '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 80;
    server_name stage.example.com;
    return 301 https://stage.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name stage.example.com;
    ssl_certificate /etc/letsencrypt/live/stage.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stage.example.com/privkey.pem;
    access_log /var/log/nginx/eisai-access.log eisai;
    # Error logs can contain full request URLs; restrict access and retention.
    error_log /var/log/nginx/eisai-error.log warn;
    client_max_body_size 6m;
    root /srv/eisai/current/apps/web/dist;
    index index.html;
    add_header Referrer-Policy no-referrer always;
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
