{
  "name": "eisai-studio-matcha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "preinstall": "node scripts/check-versions.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:seed": "npm run db:seed --workspace @eisai/api",
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w @eisai/api\" \"npm run dev -w @eisai/web\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration -w @eisai/api",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run format:check",
    "mobile:doctor": "node scripts/mobile.mjs doctor",
    "mobile:setup": "node scripts/mobile.mjs setup",
    "mobile:check": "node scripts/mobile.mjs check",
    "mobile:run": "node scripts/mobile.mjs run",
    "mail:test": "npm run mail:test -w @eisai/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
