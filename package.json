{
  "name": "eisai-studio-matcha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --names api,web --prefix-colors green,magenta \"npm run dev -w @eisai/api\" \"npm run dev -w @eisai/web\"",
    "seed": "npm run seed -w @eisai/api",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
